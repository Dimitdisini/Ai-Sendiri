+BEGIN
+  EXECUTE format('REVOKE CONNECT ON DATABASE %I FROM app_owner, app_ops, app_fin, app_report', current_database());
+  EXECUTE format('REVOKE CREATE ON DATABASE %I FROM app_ops', current_database());
+END
+$$;
