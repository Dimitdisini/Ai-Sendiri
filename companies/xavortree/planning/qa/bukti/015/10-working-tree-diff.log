+-- Hak akses database: CONNECT untuk semua role aplikasi, CREATE untuk app_ops (dibutuhkan pg-boss
+-- saat menjalankan bootstrap `CREATE SCHEMA IF NOT EXISTS jobs;`).
+DO $$
+BEGIN
+  EXECUTE format('GRANT CONNECT ON DATABASE %I TO app_owner, app_ops, app_fin, app_report', current_database());
+  EXECUTE format('GRANT CREATE ON DATABASE %I TO app_ops', current_database());
+END
+$$;
+
 -- migrate:down
